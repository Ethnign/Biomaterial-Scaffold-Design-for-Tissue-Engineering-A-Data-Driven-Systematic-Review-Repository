  "common_author_surnames_for_bibliographic_noise_detection": [
    "wang","zhang","li","liu","chen","wu","xu","et","al","mater","sci","doi","org","https","journal","adv"
  ],
  "topic_classification_thresholds": {
    "note": "Applied in order; first match wins.",
    "rules": [
      {"condition": "is_ocr_noise_heuristic", "category": "ruido_ocr", "decision": "excluir"},
      {"condition": "is_bibliographic_heuristic (>=3 of top-10 words are common author surnames)", "category": "bibliografico_editorial", "decision": "excluir"},
      {"condition": "s_met >= 0.70 AND cobertura_metodologia >= 0.60", "category": "metodologico_dominante", "decision": "excluir"},
      {"condition": "s_met < 0.40", "category": "contenido_tematico", "decision": "conservar"},
      {"condition": "else (0.40 <= s_met < 0.70, or s_met>=0.70 with cobertura<0.60)", "category": "mixto_metodologico_tematico", "decision": "revisar manualmente"}
    ],
    "s_met_definition": "sum of c-TF-IDF weights of topic's top words that are in methodology_vocabulary, divided by (that sum + sum of c-TF-IDF weights of topic's top words that are in the union of all content_axis_keywords)",
    "cobertura_metodologia_definition": "fraction of a topic's fragments containing >=1 whole-word match (word-boundary regex) against methodology_vocabulary"
  },
  "entity_cooccurrence_network": {
    "minimum_edge_weight_cooccurrence_count": 2,
    "note": "Edge added only if two entities co-occur in >=2 fragments assigned to that axis. Edge 'distance' attribute = 1/weight (used for betweenness centrality, since higher co-occurrence should mean conceptually closer, not a longer path)."
  },
  "ner_model": {
    "huggingface_model": "d4data/biomedical-ner-all",
    "aggregation_strategy": "max",
    "max_tokens": "min(512, tokenizer.model_max_length)",
    "sliding_window_overlap_tokens": 50
  }
}
